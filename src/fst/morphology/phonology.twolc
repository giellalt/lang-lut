Rules


! Vowels
"a:0 in inflection"
!! **@RULENAME@**
 a:0 <=>
        _ d: %^Pen: %^RmVOW: %^d2t: %>  ; !-t-əb Passive
    [%^Red1i13:|%^RedPL1i1i13:|%^Red1iq13:|%^Red12q13:|%^Red1213:]  %{p6%}: %{p5%}: %{p4%}: %{p3%}: %{p2%}: %{p1%}: (%{pØ%}:)  Cns _ [ Cns | Vow ] [ Lts: | » ]* ;
    
"ə:0 in inflection"
!! **@RULENAME@**
 ə:0 <=>  _ d: %> c: Vow ;!CHECKME
!!€ x̌əd»əd%>sid
!!€ x̌əd000%>cid
        _ d: %^Pen: %^RmVOW: %^d2t: %>  ; !-t-əb Passive
!echo 'b ə q̓ ə:0 d:t ^Pen:0 ^RmVOW:0 ^d2t:0 > ə b' | hfst-pair-test src/fst/phonology.compose.hfst
!!€ bəq̓əd^Pen^RmVOW^d2t>əb
!!€ bəq̓0t000>əb

   [%^Red1i13:|%^RedPL1i1i13:|%^Red1iq13:|%^Red12q13:|%^Red1213:]  %{p6%}: %{p5%}: %{p4%}: %{p3%}: %{p2%}: %{p1%}: (%{pØ%}:) Cns _ [ Cns | Vow ] [ Lts: | » ]* ;
