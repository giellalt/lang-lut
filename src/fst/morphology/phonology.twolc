 i:0 <=>  [%^Red1i13:|%^RedPL1i1i13:|%^Red1iq13:|%^Red12q13:|%^Red1213:]  %{p6%}: %{p5%}: %{p4%}: %{p3%}: %{p2%}: %{p1%}: (%{pØ%}:)  Cns _ [ Cns | Vow ] [ Lts: | » ]* ;

"í:0 in inflection"
